# Copy to .env. All values below are development defaults.
TG_DATABASE_URL=postgresql+psycopg://trialgraph:trialgraph@localhost:5433/trialgraph
TG_DATA_DIR=./data
# ACS 5-year vintage (end year). 2024 = 2020-2024 estimates.
TG_ACS_YEAR=2024
# Optional comma-separated USPS state codes to run a pilot geography, e.g. "NC,SC,VA". Empty = 50 states + DC.
TG_PILOT_STATES=
# Optional OSRM-compatible routing server for road travel time. Leave empty to disable (straight-line only).
TG_OSRM_URL=
# Frontend -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:8010
