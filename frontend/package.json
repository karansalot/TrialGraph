{
  "name": "trialgraph-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm prepare:map && next dev -H 127.0.0.1 -p 3010",
    "build": "pnpm prepare:map && next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build:static": "pnpm prepare:map && NEXT_PUBLIC_DATA_MODE=static NEXT_OUTPUT=export NEXT_DIST_DIR=out next build",
    "serve:static": "npx --yes serve@14.2.4 out -l 3020",
    "prepare:map": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "shadcn": "^4.21.4"
  },
  "packageManager": "pnpm@10.30.3"
}